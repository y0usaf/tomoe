+/* The kernel driver's name, as drmGetVersion() reports it, without libdrm:
+ * DRM_IOCTL_VERSION once for the lengths and once more for the name. */
+static int
+drm_version_ioctl(int fd, struct drm_version *v)
+{
+   int ret;
+   do {
+      ret = ioctl(fd, DRM_IOCTL_VERSION, v);
+   } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
+   return ret;
+}
+
+static char *
+drm_driver_name(int fd)
+{
+   struct drm_version v = {0};
+   if (drm_version_ioctl(fd, &v) || v.name_len == 0)
+      return NULL;
+   size_t len = v.name_len;
+   char *name = calloc(len + 1, 1);
+   if (!name)
+      return NULL;
+   v = (struct drm_version){ .name_len = len, .name = name };
+   if (drm_version_ioctl(fd, &v)) {
+      free(name);
+      return NULL;
+   }
+   name[len < v.name_len ? len : v.name_len] = '\0';
+   return name;
+}
