+
+void wlr_screencopy_manager_v1_set_buffer_provider(
+		struct wlr_screencopy_manager_v1 *manager,
+		wlr_screencopy_buffer_provider_func_t provider, void *data) {
+	manager->buffer_provider = provider;
+	manager->buffer_provider_data = data;
+}
+
+void wlr_screencopy_manager_v1_set_suspended(
+		struct wlr_screencopy_manager_v1 *manager, bool suspended) {
+	if (manager->suspended == suspended) {
+		return;
+	}
+	manager->suspended = suspended;
+	if (suspended) {
+		return;
+	}
+	struct wlr_screencopy_frame_v1 *frame, *tmp;
+	wl_list_for_each_safe(frame, tmp, &manager->frames, link) {
+		if (frame->output && !frame->output->enabled) {
+			zwlr_screencopy_frame_v1_send_failed(frame->resource);
+			frame_destroy(frame);
+		} else if (frame->output && frame->buffer) {
+			wlr_output_schedule_frame(frame->output);
+		}
+	}
+}
