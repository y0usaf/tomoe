--- a/include/wlr/types/wlr_screencopy_v1.h
+++ b/include/wlr/types/wlr_screencopy_v1.h
@@ -23,0 +24,14 @@
+struct wlr_screencopy_frame_v1;
+struct wlr_output_state;
+
+/**
+ * Supply the source for a pending copy at an output buffer commit. The result
+ * must use the committed buffer's native pixel coordinates and dimensions.
+ * Return one locked buffer (the manager unlocks it on every path), or NULL to
+ * fail this frame. Called synchronously; do not dispatch events or commit an
+ * output from this callback. With no provider, the committed buffer is used.
+ */
+typedef struct wlr_buffer *(*wlr_screencopy_buffer_provider_func_t)(
+	struct wlr_screencopy_frame_v1 *frame,
+	const struct wlr_output_state *state, void *data);
+
@@ -26,0 +41,3 @@
+	wlr_screencopy_buffer_provider_func_t buffer_provider;
+	void *buffer_provider_data;
+	bool suspended;
@@ -73,0 +91,12 @@
+void wlr_screencopy_manager_v1_set_buffer_provider(
+	struct wlr_screencopy_manager_v1 *manager,
+	wlr_screencopy_buffer_provider_func_t provider, void *data);
+
+/**
+ * Defer copy fulfillment while an output transaction is unresolved. Calls are
+ * idempotent; resume requests fresh frames for pending copies. Output removal
+ * still fails its frames immediately. Preserve an outer suspension when nesting.
+ */
+void wlr_screencopy_manager_v1_set_suspended(
+	struct wlr_screencopy_manager_v1 *manager, bool suspended);
+
