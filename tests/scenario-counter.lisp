(in-package #:tomoe-user)

(define-extension "scenario-counter" (:reads (:pointer :button)
                                     :state (list :moves 0 :buttons 0))
    (snapshot state event)
  (declare (ignore snapshot))
  (let* ((type (getf event :type))
         (pointer (eq type :pointer))
         (button (eq type :button))
         (moves (if pointer (1+ (getf state :moves 0)) (getf state :moves 0)))
         (buttons (if button (1+ (getf state :buttons 0)) (getf state :buttons 0))))
    (when (or pointer button)
      (scenario-note (format nil "counter ~A ~A ~A" type (getf event :state) (getf event :id))))
    (values (list :moves moves :buttons buttons)
            (list (publish-state :scenario-counter (list :moves moves :buttons buttons)))
            nil)))
