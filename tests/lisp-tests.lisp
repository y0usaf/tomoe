(defun unit-optional (a &optional (b 2 b-p) &key (c 3) &allow-other-keys &rest rest)
  (list a b b-p c rest))
(unit-check "optional-default" '(1 2 nil 3 nil) (unit-optional 1))
(unit-check "optional-supplied" '(1 5 t 3 nil) (unit-optional 1 5))
(unit-check "key-args" '(1 2 t 9 (:c 9 :other t)) (unit-optional 1 2 :c 9 :other t))

(defun unit-rest (&rest values) values)
(unit-check "rest" '(1 2 3) (unit-rest 1 2 3))

(defun unit-counter ()
  (let ((count 0))
    (list (lambda () (incf count)) (lambda () count))))
(destructuring-bind (bump peek) (unit-counter)
  (funcall bump)
  (funcall bump)
  (unit-check "closure-reference" 2 (funcall peek)))

(defvar *unit-special* 1)
(defun unit-read-special () *unit-special*)
(unit-check "special-let" 2 (let ((*unit-special* 2)) (unit-read-special)))
(unit-check "special-restored" 1 (unit-read-special))
(unit-check "special-error-restore" 1
            (progn (ignore-errors (let ((*unit-special* 3)) (error "boom")))
                   (unit-read-special)))

(defun unit-block (value)
  (block outer
    (when value (return-from outer :early))
    :late))
(unit-check "block" :early (unit-block t))
(unit-check "block-fallthrough" :late (unit-block nil))
(unit-check "implicit-block" 7 (block nil (return 7)))
(unit-check "dolist-return" 2
            (block nil (dolist (x '(1 2 3)) (when (= x 2) (return x)))))

