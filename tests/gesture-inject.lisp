(in-package #:tomoe)
(define-native ("pointer_gesture_begin" %test-gesture-begin) sb-alien:void
  (server (* t)) (device (* t)) (kind sb-alien:unsigned-int)
  (time sb-alien:unsigned-int) (fingers sb-alien:unsigned-int))
(define-native ("pointer_gesture_update" %test-gesture-update) sb-alien:void
  (server (* t)) (device (* t)) (kind sb-alien:unsigned-int)
  (time sb-alien:unsigned-int) (dx sb-alien:double) (dy sb-alien:double)
  (scale sb-alien:double) (rotation sb-alien:double))
(define-native ("pointer_gesture_end" %test-gesture-end) sb-alien:void
  (server (* t)) (device (* t)) (kind sb-alien:unsigned-int)
  (time sb-alien:unsigned-int) (cancelled sb-alien:int))
(define-native ("input_device_create" %test-device-create) (* t)
  (server (* t)) (name sb-alien:c-string) (caps sb-alien:unsigned-int))
(define-native ("input_device_destroy" %test-device-destroy) sb-alien:void (device (* t)))
(let ((step (symbol-function '%step)) (device nil) (other nil)
      (path (sb-ext:posix-getenv "TOMOE_GESTURE_TEST")))
  (setf (symbol-function '%step)
        (lambda (server timeout)
          (let ((result (funcall step server timeout)))
            (unless device (setf device (%test-device-create server "private-gesture-test" 2)))
            (unless other (setf other (%test-device-create server "private-other-test" 2)))
            (when (probe-file path)
              (let ((request (with-open-file (stream path) (read stream))))
                (delete-file path)
                (case (first request)
                  (:begin (apply #'%test-gesture-begin server device (rest request)))
                  (:update (apply #'%test-gesture-update server device (rest request)))
                  (:other-update (apply #'%test-gesture-update server other (rest request)))
                  (:end (apply #'%test-gesture-end server device (rest request)))
                  (:remove (%test-device-destroy device) (setf device nil))
                  (:stop (%test-device-destroy device) (%test-device-destroy other)
                         (setf (symbol-function '%step) step)))))
            result))))
