== mount chain
-- dispatch
chain-alpha MOUNT count=1 emits=0
chain-beta MOUNT alpha=0 emits=0
chain-gamma MOUNT beta=0
chain-delta MOUNT windows=(1 2)
chain-alpha CHANGE keys=(:DATA :FOCUS) count=2 emits=0
chain-beta CHANGE keys=(:DATA :FOCUS) alpha=2 emits=0
chain-gamma CHANGE keys=(:DATA :FOCUS) beta=1
chain-delta MOUNT windows=(1 2)
chain-alpha CHANGE keys=(:DATA) count=3 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
chain-gamma CHANGE keys=(:DATA) beta=3
chain-delta MOUNT windows=(1 2)
chain-alpha CHANGE keys=(:DATA) count=4 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
chain-gamma CHANGE keys=(:DATA) beta=3
chain-delta MOUNT windows=(1 2)
-- commands
chain-alpha MOUNT count=1 emits=0
chain-beta MOUNT alpha=0 emits=0
chain-alpha CHANGE keys=(:DATA :FOCUS) count=2 emits=0
chain-beta CHANGE keys=(:DATA :FOCUS) alpha=2 emits=0
chain-alpha CHANGE keys=(:DATA) count=3 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
chain-alpha CHANGE keys=(:DATA) count=4 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
