-- dispatch
chain-alpha MOUNT count=1 emits=0
chain-beta MOUNT alpha=0 emits=0
chain-gamma MOUNT beta=0
rule-owner MOUNT declarations=0
trace-fail-a MOUNT runs=1
trace-fail-b MOUNT
trace-cycle-a MOUNT coupled=NIL b=0
trace-cycle-b MOUNT coupled=NIL a=0
