trace-cycle-b CHANGE keys=(:DATA) coupled=T a=3
chain-delta BUTTON id=1 windows=(1 2)
trace-cycle-a CHANGE keys=(:DATA) coupled=T b=3
trace-cycle-b CHANGE keys=(:DATA) coupled=T a=3
