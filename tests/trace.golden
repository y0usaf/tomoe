:LAYOUT ((:ID 1 :X 0 :Y 0 :WIDTH 400 :HEIGHT 300 :VISIBLE T :FULLSCREEN NIL :MAXIMIZE NIL :PROPERTIES NIL) (:ID 2 :X 0 :Y 0 :WIDTH 240 :HEIGHT 160 :VISIBLE T :FULLSCREEN NIL :MAXIMIZE NIL :PROPERTIES NIL))
:STACKING (1 2)
:FOCUS 2
:LAYERS NIL
:SETTINGS (:SCALE 1 :MOD :SUPER :FOCUS-FOLLOWS-MOUSE NIL :POINTER-FOLLOWS-FOCUS NIL :TEARING NIL :WAIT-FOR-FRAME-COMPLETION NIL :NESTED-SIZE (:WIDTH 1280 :HEIGHT 800) :TOUCHPAD NIL :MOUSE NIL :DEVICES NIL :BORDER (:WIDTH 2 :FOCUSED "#7aa2f7" :UNFOCUSED "#3b4261" :RADIUS 0) :SHADOW (:RANGE 12 :COLOR "#00000099" :POWER 3) :BLUR (:ENABLED NIL :PASSES 3 :OFFSET 1 :ANTI-ARTIFACT-MARGIN 96 :LAYER-NAMESPACES NIL) :ANIMATIONS (:WINDOW-MOVE (:KIND :SPRING :DAMPING-RATIO 1.0d0 :STIFFNESS 16000.0d0 :EPSILON 0.001d0) :WINDOW-OPEN (:KIND :EASE :DURATION-MS 90 :CURVE :EASE-OUT-EXPO) :WINDOW-CLOSE (:KIND :OF
F) :WINDOW-RESIZE (:KIND :OFF) :WINDOW-SWITCH (:KIND :OFF) :WINDOW-VIEW (:KIND :SPRING :DAMPING-RATIO 1.0d0 :STIFFNESS 16000.0d0 :EPSILON 0.001d0) :WINDOW-ALPHA (:KIND :OFF) :WINDOW-TINT (:KIND :OFF) :WINDOW-SCALE (:KIND :OFF) :WINDOW-ROTATION (:KIND :OFF) :WINDOW-TRANSLATE (:KIND :OFF)) :SCREENSHOT-FREEZE T :SCREENSHOT-COLORS (:ACCENT "#7aa1f7" :BACKGROUND "#1c1c21" :TEXT "#ffffff" :CHIP "#45454f") :WATCHDOG-MS 1000 :FORCE-SERVER-SIDE-DECORATIONS NIL :HONOR-XDG-ACTIVATION-WITH-INVALID-SERIAL NIL)
:WORKAREAS ((:NAME "HEADLESS-1" :X 0 :Y 0 :WIDTH 1280 :HEIGHT 720))
:SURFACES NIL
:DATA ((:CHAIN-ALPHA . 2) (:CHAIN-BETA . 3) (:CHAIN-GAMMA . 6))
:RULES ((:ID 1 :PROPERTIES NIL) (:ID 2 :PROPERTIES NIL))
:WINDOW-GEOMETRY ((:ID 1 :X 0 :Y 0 :WIDTH 400 :HEIGHT 300) (:ID 2 :X 0 :Y 0 :WIDTH 240 :HEIGHT 160))
:VIRTUAL-OUTPUTS NIL
:CONFIG-ERROR NIL
:KEYBOARD-GRAB NIL
:COMMANDS ((:NAME "patch" :OWNER "session" :HOST T :DESCRIPTION "Apply a patch file or forms to the running session." :ARGUMENTS ((:NAME :FILE :TYPE :STRING :REQUIRED NIL :DEFAULT NIL :DEFAULT-P NIL :DESCRIPTION "A patch source file." :VALUES NIL :MAXIMUM NIL) (:NAME :FORMS :TYPE :STRING :REQUIRED NIL :DEFAULT NIL :DEFAULT-P NIL :DESCRIPTION "Lisp forms instead of a file, up to 64 KiB." :VALUES NIL :MAXIMUM NIL) (:NAME :NAME :TYPE :STRING :REQUIRED NIL :DEFAULT NIL :DEFAULT-P NIL :DESCRIPTION "Patch name, by default patch-N." :VALUES NIL :MAXIMUM NIL))) (:NAME "undo-patch" :OWNER "session" :HO
ST T :DESCRIPTION "Undo a patch, restoring its definitions and removing its effects." :ARGUMENTS ((:NAME :NAME :TYPE :STRING :REQUIRED NIL :DEFAULT NIL :DEFAULT-P NIL :DESCRIPTION "Patch name, by default the most recent patch." :VALUES NIL :MAXIMUM NIL) (:NAME :ID :TYPE :INTEGER :REQUIRED NIL :DEFAULT NIL :DEFAULT-P NIL :DESCRIPTION "Patch number, when the name is unknown." :VALUES NIL :MAXIMUM NIL))))
:BINDINGS NIL
:PENDING-CONTEXT NIL
