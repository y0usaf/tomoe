== mount chain
-- dispatch
chain-alpha MOUNT count=1 emits=0
chain-beta MOUNT alpha=0 emits=0
chain-gamma MOUNT beta=0
chain-delta MOUNT windows=(1 2)
chain-alpha CHANGE keys=(:DATA :FOCUS) count=2 emits=0
chain-beta CHANGE keys=(:DATA :FOCUS) alpha=2 emits=0
chain-gamma CHANGE keys=(:DATA :FOCUS) beta=1
chain-delta MOUNT windows=(1 2)
chain-alpha CHANGE keys=(:DATA) count=3 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
chain-gamma CHANGE keys=(:DATA) beta=3
chain-delta MOUNT windows=(1 2)
chain-alpha CHANGE keys=(:DATA) count=4 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
chain-gamma CHANGE keys=(:DATA) beta=3
chain-delta MOUNT windows=(1 2)
-- commands
chain-alpha MOUNT count=1 emits=0
chain-beta MOUNT alpha=0 emits=0
chain-alpha CHANGE keys=(:DATA :FOCUS) count=2 emits=0
chain-beta CHANGE keys=(:DATA :FOCUS) alpha=2 emits=0
chain-alpha CHANGE keys=(:DATA) count=3 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
chain-alpha CHANGE keys=(:DATA) count=4 emits=0
chain-beta CHANGE keys=(:DATA) alpha=2 emits=0
-- committed
:LAYOUT ((:ID 1 :X 0 :Y 0 :WIDTH 400 :HEIGHT 300 :VISIBLE T :FULLSCREEN NIL :MAXIMIZE NIL :PROPERTIES NIL) (:ID 2 :X 0 :Y 0 :WIDTH 240 :HEIGHT 160 :VISIBLE T :FULLSCREEN NIL :MAXIMIZE NIL :PROPERTIES NIL))
:STACKING (1 2)
:FOCUS 2
:LAYERS NIL
:SETTINGS (:SCALE 1 :MOD :SUPER :FOCUS-FOLLOWS-MOUSE NIL :POINTER-FOLLOWS-FOCUS NIL :TEARING NIL :WAIT-FOR-FRAME-COMPLETION NIL :NESTED-SIZE (:WIDTH 1280 :HEIGHT 800) :TOUCHPAD NIL :MOUSE NIL :DEVICES NIL :BORDER (:WIDTH 2 :FOCUSED "#7aa2f7" :UNFOCUSED "#3b4261" :RADIUS 0) :SHADOW (:RANGE 12 :COLOR "#00000099" :POWER 3) :BLUR (:ENABLED NIL :PASSES 3 :OFFSET 1 :ANTI-ARTIFACT-MARGIN 96 :LAYER-NAMESPACES NIL) :ANIMATIONS (:WINDOW-MOVE (:KIND :SPRING :DAMPING-RATIO 1.0d0 :STIFFNESS 800.0d0 :EPSILON 1.0d-4) :WINDOW-OPEN (:KIND :EASE :DURATION-MS 150 :CURVE :EASE-OUT-EXPO) :WINDOW-CLOSE (:KIND :OFF)
 :WINDOW-RESIZE (:KIND :OFF) :WINDOW-SWITCH (:KIND :OFF) :WINDOW-VIEW (:KIND :OFF) :WINDOW-ALPHA (:KIND :OFF) :WINDOW-TINT (:KIND :OFF) :WINDOW-SCALE (:KIND :OFF) :WINDOW-ROTATION (:KIND :OFF) :WINDOW-TRANSLATE (:KIND :OFF)) :SCREENSHOT-FREEZE T :SCREENSHOT-COLORS (:ACCENT "#7aa1f7" :BACKGROUND "#1c1c21" :TEXT "#ffffff" :CHIP "#45454f") :WATCHDOG-MS 1000 :FORCE-SERVER-SIDE-DECORATIONS NIL :HONOR-XDG-ACTIVATION-WITH-INVALID-SERIAL NIL)
:WORKAREAS ((:NAME "HEADLESS-1" :X 0 :Y 0 :WIDTH 1280 :HEIGHT 720))
:SURFACES NIL
:DATA ((:CHAIN-ALPHA . 2) (:CHAIN-BETA . 3) (:CHAIN-GAMMA . 6))
:RULES ((:ID 1 :PROPERTIES NIL) (:ID 2 :PROPERTIES NIL))
:WINDOW-GEOMETRY ((:ID 1 :X 0 :Y 0 :WIDTH 400 :HEIGHT 300) (:ID 2 :X 0 :Y 0 :WIDTH 240 :HEIGHT 160))
