extension (:NAME "chain-beta" :READS (:DATA) :ADMISSION NIL :STATE (:BETA 3) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :CHAIN-BETA 3)))
