== swap button two
-- dispatch
chain-alpha BUTTON id=1 count=5 emits=1
rule-owner BUTTON id=1 declarations=4
trace-fail-a BUTTON id=1 runs=5
trace-fail-b BUTTON id=1
trace-cycle-a BUTTON id=1 coupled=NIL b=0
trace-mount-a BUTTON id=1
trace-mount-b BUTTON id=1
trace-grid BUTTON id=1 windows=(1 2 3 4 5 6 7 8)
trace-delay BUTTON id=1 windows=8 fired=T
trace-swap BUTTON id=1 x=55 runs=4
rule-apply window=1 seen=5 BUTTON id=1
trace-grid-apply window=1 BUTTON id=1
chain-delta BUTTON id=1 windows=(1 2 3 4 5 6 7 8)
rule-apply window=1 seen=6 CHANGE keys=(:RULES)
trace-grid-apply window=1 CHANGE keys=(:RULES)
