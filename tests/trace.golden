-- reply 0
== cyclic button
-- dispatch
trace-cycle-a BUTTON id=1 coupled=T b=0
chain-delta BUTTON id=1 windows=(1 2)
trace-cycle-a CHANGE keys=(:DATA) coupled=T b=0
trace-cycle-b CHANGE keys=(:DATA) coupled=T a=1
chain-delta BUTTON id=1 windows=(1 2)
trace-cycle-a CHANGE keys=(:DATA) coupled=T b=1
trace-cycle-b CHANGE keys=(:DATA) coupled=T a=1
chain-delta BUTTON id=1 windows=(1 2)
