== mount grid
-- dispatch
trace-grid MOUNT windows=(1 2 3 4 5 6 7 8)
trace-grid-apply window=1 MOUNT
trace-grid-apply window=1 CHANGE keys=(:WINDOW-GEOMETRY :RULES :LAYOUT)
