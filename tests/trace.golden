extension (:NAME "chain-alpha" :READS (:BUTTON :DATA :WINDOWS) :ADMISSION NIL :STATE (:COUNT 4) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :CHAIN-ALPHA 8)))
extension (:NAME "chain-beta" :READS (:DATA) :ADMISSION NIL :STATE (:BETA 9) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :CHAIN-BETA 9)))
extension (:NAME "chain-gamma" :READS (:DATA) :ADMISSION NIL :STATE (:GAMMA 18) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :CHAIN-GAMMA 18)))
extension (:NAME "chain-delta" :READS (:BUTTON :DATA :WINDOWS) :ADMISSION T :STATE (:IDS (1 2 3 4 5 6 7 8)) :DISPATCHES 40 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:FOCUS 8 T)))
extension (:NAME "rule-owner" :READS (:BUTTON :DATA) :ADMISSION NIL :STATE (:DECLARATIONS 4) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:RULE :TRACE "trace-window" NIL ((:TRACE . 3)) (:WINDOWS) (:SEEN 0))))
extension (:NAME "trace-fail-a" :READS (:BUTTON :DATA) :ADMISSION NIL :STATE (:RUNS 4) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :TRACE-FAIL-A :A)))
extension (:NAME "trace-fail-b" :READS (:BUTTON :DATA) :ADMISSION NIL :STATE NIL :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :TRACE-FAIL-B :OK)))
extension (:NAME "trace-cycle-a" :READS (:BUTTON :DATA) :ADMISSION NIL :STATE (:COUPLED NIL) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS NIL)
extension (:NAME "trace-cycle-b" :READS (:DATA) :ADMISSION NIL :STATE (:COUPLED NIL) :DISPATCHES 4 :FAILURES 0 :LAST-ERROR NIL :EFFECTS NIL)
extension (:NAME "trace-mount-a" :READS (:BUTTON) :ADMISSION NIL :STATE NIL :DISPATCHES 1 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :TRACE-SHARED (:OWNER "a"))))
extension (:NAME "trace-mount-b" :READS (:BUTTON) :ADMISSION NIL :STATE NIL :DISPATCHES 1 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:DATA :TRACE-SHARED (:OWNER "b")) (:TIMER :TRACE-MOUNT-TICK 600000 T)))
extension (:NAME "trace-grid" :READS (:WINDOWS :BUTTON) :ADMISSION NIL :STATE (:IDS (1 2 3 4 5 6 7 8)) :DISPATCHES 1 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:PLACE 1 0 0 320 240 T) (:PLACE 2 160 0 240 160 T) (:PLACE 3 320 0 200 150 T) (:PLACE 4 480 0 200 150 T) (:PLACE 5 0 120 200 150 T) (:PLACE 6 160 120 200 150 T) (:PLACE 7 320 120 200 150 T) (:PLACE 8 480 120 200 150 T) (:RULE :TRACE-GRID "trace-window" NIL ((:TRACE-GRID . 8)) (:WINDOWS) (:SEEN 0))))
extension (:NAME "trace-delay" :READS (:WINDOWS :BUTTON) :ADMISSION NIL :STATE (:FIRED T) :DISPATCHES 2 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:PLACE 1 40 60 320 240 T)))
extension (:NAME "trace-swap" :READS (:WINDOWS :BUTTON) :ADMISSION NIL :STATE (:RUNS 3) :DISPATCHES 3 :FAILURES 0 :LAST-ERROR NIL :EFFECTS ((:PLACE 1 56 200 320 240 T) (:PLACE 2 57 200 240 160 T) (:PLACE 3 58 200 200 150 T) (:PLACE 4 59 200 200 150 T) (:PLACE 5 60 200 200 150 T) (:PLACE 6 61 200 200 150 T) (:PLACE 7 62 200 200 150 T) (:PLACE 8 63 200 200 150 T)))
