:BINDINGS NIL
:PENDING-CONTEXT NIL
:VIEW (:X 0 :Y 0 :ZOOM 1.0d0)
:OUTPUTS ((:NAME "HEADLESS-1" :X 0 :Y 0 :WIDTH 1280 :HEIGHT 720 :PHYSICAL-WIDTH 1280 :PHYSICAL-HEIGHT 720 :REFRESH-MHZ 60000 :SCALE-120 120 :TRANSFORM 0 :ADAPTIVE-SYNC-SUPPORTED NIL :ADAPTIVE-SYNC NIL :ICC NIL :ICC-ERROR NIL :MODES NIL))
:CONNECTORS ((:ID 1 :NAME "HEADLESS-1" :ENABLED T :PENDING NIL :ADAPTIVE-SYNC-SUPPORTED NIL :ADAPTIVE-SYNC NIL :REQUEST-ID 0 :REQUEST-PENDING NIL :POWER T :MODES NIL :RENDER (:FORMAT "XR24" :MODIFIER 0 :IMPLICIT NIL :WIDTH 1280 :HEIGHT 720 :FENCED NIL)))
