(defvar *stub-log* nil)

(defun stub-record (name &rest arguments)
  (push (cons name arguments) *stub-log*)
  (first arguments))

(defun %keysym (name) (stub-record '%keysym name) (length name))
(defun %now-ms () 0)
(defun %strftime (format) (declare (ignore format)) "00:00")
(defun %log (level text) (stub-record '%log level text) nil)
(defun %getenv (name) (stub-record '%getenv name) nil)
(defun %list-directory (path) (stub-record '%list-directory path) nil)
(defun %read-file (path limit) (declare (ignore limit)) (stub-record '%read-file path) nil)
(defun %write-patch-file (name text)
  (declare (ignore text))
  (concatenate 'string "/tmp/" name ".lisp"))
(defun %delete-file (path) (stub-record '%delete-file path) nil)
(defun %write-append (path text) (declare (ignore text)) (stub-record '%write-append path) nil)
(defun %read-source (text package) (declare (ignore text package)) nil)
(defun %symbol-definition (symbol) (list :symbol symbol))
(defun %set-symbol-definition (symbol definition) (declare (ignore definition)) symbol)
(defun %set-reads (reads) (stub-record '%set-reads reads) nil)

