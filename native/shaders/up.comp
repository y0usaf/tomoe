#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform texture2D tex_image;
layout(set = 1, binding = 0) uniform sampler tex_sampler;
layout(set = 2, binding = 0) writeonly uniform image2D dst_image;
layout(push_constant) uniform Blur {
    vec2 half_pixel;
    vec2 uv_step;
    vec2 uv_origin;
    vec2 uv_min;
    vec2 uv_max;
    ivec2 rect_off;
    ivec2 rect_end;
    float offset;
    float grain;
    float vibrancy;
};
vec4 at(vec2 uv) {
    return texture(sampler2D(tex_image, tex_sampler), uv);
}
void main() {
    ivec2 p = rect_off + ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= rect_end.x || p.y >= rect_end.y) return;
    vec2 v_tex = uv_origin + vec2(p) * uv_step;
    vec2 d = half_pixel * offset;
    vec4 sum = at(v_tex + vec2(-d.x * 2.0, 0.0));
    sum += at(v_tex + vec2(-d.x, d.y)) * 2.0;
    sum += at(v_tex + vec2(0.0, d.y * 2.0));
    sum += at(v_tex + d) * 2.0;
    sum += at(v_tex + vec2(d.x * 2.0, 0.0));
    sum += at(v_tex + vec2(d.x, -d.y)) * 2.0;
    sum += at(v_tex + vec2(0.0, -d.y * 2.0));
    sum += at(v_tex + vec2(-d.x, -d.y)) * 2.0;
    vec4 c = sum / 12.0;
    if (vibrancy != 1.0) {
        float l = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));
        c.rgb = clamp(mix(vec3(l), c.rgb, vibrancy), 0.0, 1.0);
    }
    if (grain > 0.0) {
        vec2 q = vec2(p) + 0.5;
        float a = fract(52.9829189 * fract(dot(q, vec2(0.06711056, 0.00583715))));
        float b = fract(52.9829189 * fract(dot(q + vec2(23.0, 61.0), vec2(0.00583715, 0.06711056))));
        c.rgb += (a + b - 1.0) * grain / 255.0;
    }
    imageStore(dst_image, p, c);
}
